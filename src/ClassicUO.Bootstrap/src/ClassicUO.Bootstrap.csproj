<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>Preview</LangVersion>
    <AssemblyName>ClassicUO</AssemblyName>
    <RootNamespace>ClassicUO</RootNamespace>
    <ApplicationIcon>cuoicon.ico</ApplicationIcon>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <Platforms>x86;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="cuoicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\external\cuoapi\src\cuoapi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ClassicUO.PluginHost\ClassicUO.PluginHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPluginHost" AfterTargets="Build">
    <PropertyGroup>
      <_PluginHostDir>$(MSBuildThisFileDirectory)..\..\ClassicUO.PluginHost\bin\$(Platform)\$(Configuration)\</_PluginHostDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_PluginHostDir)PluginHost.exe" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(_PluginHostDir)PluginHost.exe')" />
    <Copy SourceFiles="$(_PluginHostDir)PluginHostConfig.json" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(_PluginHostDir)PluginHostConfig.json')" />
  </Target>

</Project>
